# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to git, and never paste keys into chat/docs/screenshots.

# Powers the /tools page (Ad Copy + SEO Meta generators), via Vercel AI Gateway.
# Easiest setup: run `vercel link` then `vercel env pull` in this project —
# that writes AI_GATEWAY_API_KEY into .env.local automatically.
# Manual alternative: get a key from your Vercel dashboard -> AI Gateway -> API Keys.
AI_GATEWAY_API_KEY=

# Optional shared-password gate for /tools and /api/generate.
# Leave blank to keep the tools page fully public.
ACCESS_PIN=
